# Copy to .env and adjust values. Production secrets come from the environment only.
# NOTE: never commit a real .env — only this example file belongs in Git.

# ── Database ─────────────────────────────────────────────
# Local Docker Postgres (see docker-compose.yml). In production point these at
# the managed provider (Neon/Supabase/…).
#   DATABASE_URL = pooled  → used by the app at runtime (Neon: the `-pooler` host)
#   DIRECT_URL   = direct  → used by `prisma migrate` (never the pooler)
# BOTH are required: prisma/schema.prisma declares `directUrl = env("DIRECT_URL")`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/ecomcolab?schema=public"
# Neon example: DATABASE_URL uses `<endpoint>-pooler.<region>.aws.neon.tech` and
# DIRECT_URL uses the same host WITHOUT `-pooler`.
# ⚠️ Never append `channel_binding=require` (Neon's default on some dashboards):
#    Prisma's connector rejects it and every connection fails with
#    `P1001: Can't reach database server`. Keep only `?sslmode=require`.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5433/ecomcolab?schema=public"

# ── Authentication ───────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Must match the origin you browse: Auth.js derives cookie names and redirects
# from this value, so a production URL here breaks local sign-in.
NEXTAUTH_URL="http://localhost:3000"
# Production: set the real deployed origin, e.g. https://your-app.vercel.app

# ── Scheduled jobs ───────────────────────────────────────
# Shared secret for the settlement cron (GET /api/cron/settle?key=… or
# Authorization: Bearer …). Unset = the endpoint refuses all calls.
CRON_SECRET=""

# ── Telegram ingestion (optional) ────────────────────────
# Leave both empty to disable ingestion; /parametres/system will report
# "Non configuré". The webhook authenticates with TELEGRAM_WEBHOOK_SECRET.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# ── One-off provisioning scripts (never read by the application) ──
# Pass these on the command line, never in this file, and never commit them:
#   ADMIN_EMAIL, ADMIN_PASSWORD
#     → npx tsx scripts/create-admin.ts
#   USER_EMAIL, USER_PASSWORD, USER_ROLE (+ PARTNER_NAME, PARTNER_CODE)
#     → npx tsx scripts/create-user.ts
