# Copy to .env and adjust values. Production secrets come from the environment only.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/ecomcolab?schema=public"
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
# Shared secret for the settlement cron (GET /api/cron/settle?key=… or Authorization: Bearer …)
CRON_SECRET=""
