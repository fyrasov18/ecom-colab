# Copy to .env and adjust values. Production secrets come from the environment only.
# NOTE: never commit a real .env — only this example file belongs in Git.

# ── Database ─────────────────────────────────────────────
# Local Docker Postgres (see docker-compose.yml). In production point this at the
# managed provider, e.g. Neon/Supabase pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/ecomcolab?schema=public"
# Optional: direct (non-pooled) URL, required by some providers for migrations.
# DIRECT_URL="postgresql://USER:PASSWORD@host:5432/ecomcolab?schema=public"

# ── Authentication ───────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Production: set to the real deployed origin, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Scheduled jobs ───────────────────────────────────────
# Shared secret for the settlement cron (GET /api/cron/settle?key=… or
# Authorization: Bearer …). Unset = the endpoint refuses all calls.
CRON_SECRET=""

# ── Telegram ingestion (optional) ────────────────────────
# Leave both empty to disable ingestion; /parametres/system will report
# "Non configuré". The webhook authenticates with TELEGRAM_WEBHOOK_SECRET.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
