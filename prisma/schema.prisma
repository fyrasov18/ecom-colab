generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                 @id @default(cuid())
  email               String                 @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                Role                   @default(PARTNER)
  status              UserStatus             @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  auditLogs           AuditLog[]
  createdTransactions FinancialTransaction[]
  notifications       Notification[]
  createdOrders       Order[]
  orderStatusChanges  OrderStatusHistory[]
  partner             Partner?
  reviewedWithdrawals Withdrawal[]           @relation("WithdrawalReviewer")
  /// Partners this user invited (registration referral). Set server-side only —
  /// the "admin" invitation code records the inviting Admin here.
  invitedPartners      Partner[]                @relation("PartnerInvitedBy")

  @@index([role, status])
}

model Partner {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  code                   String                 @unique
  displayName            String
  status                 PartnerStatus          @default(ACTIVE)
  defaultCommissionType  CommissionType         @default(PERCENTAGE)
  defaultCommissionValue Decimal                @default(60) @db.Decimal(12, 3)
  notes                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  /// Optional performance tier. NULL until an Admin assigns one — while NULL the
  /// existing commission resolution chain stays authoritative, so no historical
  /// order is ever recalculated by introducing levels.
  performanceLevelId     String?
  /// Self-declared phone at registration (Tunisian, normalized to 8 digits).
  /// NULL for accounts provisioned before registration existed.
  phone                  String?
  /// Self-declared e-commerce experience at registration. NULL for accounts
  /// provisioned before registration existed.
  experienceLevel        EcommerceExperience?
  /// Who invited this partner (registration referral). Resolved server-side:
  /// the "admin" invitation code records the inviting Admin, never a
  /// client-supplied id. NULL for accounts provisioned before registration.
  invitedByUserId        String?
  invitedBy              User?                  @relation("PartnerInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  customers              Customer[]
  transactions           FinancialTransaction[]
  orders                 Order[]
  performanceLevel       PerformanceLevel?      @relation(fields: [performanceLevelId], references: [id])
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedProducts       PartnerProduct[]
  socialAccounts         PartnerSocialAccount[]
  wallet                 Wallet?
  withdrawals            Withdrawal[]
  referralLinks          ReferralLink[]
  referrerAttributions   ReferralAttribution[]  @relation("ReferrerAttributions")
  referredAttribution    ReferralAttribution?   @relation("ReferredAttribution")
  referralCommissions    ReferralCommission[]

  @@index([status])
}

model PartnerSocialAccount {
  id        String         @id @default(cuid())
  partnerId String
  platform  SocialPlatform
  label     String
  url       String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  partner   Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PerformanceLevel {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String?
  /// Percentage of the profit pool routed to the partner (0–100, validated).
  sharePercentage Decimal   @db.Decimal(5, 2)
  /// Free-form criteria document (thresholds, windows, weights). Intentionally
  /// untyped so the criteria can evolve without a migration.
  criteria        Json?
  isActive        Boolean   @default(true)
  /// Ascending priority: higher sortOrder = higher tier.
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  partners        Partner[]

  @@index([isActive, sortOrder])
}

model Product {
  id                  String                  @id @default(cuid())
  name                String
  slug                String                  @unique
  description         String?
  purchaseCost        Decimal                 @db.Decimal(12, 3)
  packagingCost       Decimal                 @db.Decimal(12, 3)
  deliveryCost        Decimal                 @db.Decimal(12, 3)
  sellingPrice        Decimal                 @db.Decimal(12, 3)
  stockQuantity       Int                     @default(0)
  lowStockThreshold   Int                     @default(5)
  status              ProductStatus           @default(ACTIVE)
  commissionType      CommissionType?
  commissionValue     Decimal?                @db.Decimal(12, 3)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  category            String?
  ingestedFrom        String?
  sku                 String?
  source              ProductSource           @default(ADMIN)
  supplierRef         String?
  orderItems          OrderItem[]
  partnerAssignations PartnerProduct[]
  marketingAssets     ProductMarketingAsset[]
  media               ProductMedia[]
  telegramSessions    TelegramSession[]

  @@index([status])
}

model ProductMedia {
  id             String    @id @default(cuid())
  productId      String
  type           MediaType
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  googleDriveUrl String
  title          String?
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductMarketingAsset {
  id        String             @id @default(cuid())
  productId String
  kind      MarketingAssetKind
  title     String?
  content   String?
  mediaUrl  String?
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind])
}

model PartnerProduct {
  id              String               @id @default(cuid())
  partnerId       String
  productId       String
  status          PartnerProductStatus @default(ACTIVE)
  commissionType  CommissionType?
  commissionValue Decimal?             @db.Decimal(12, 3)
  assignedAt      DateTime             @default(now())
  deactivatedAt   DateTime?
  partner         Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([partnerId, productId])
  @@index([productId, status])
}

model Customer {
  id             String   @id @default(cuid())
  ownerPartnerId String
  fullName       String
  phone          String
  governorate    String
  city           String
  address        String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ownerPartner   Partner  @relation(fields: [ownerPartnerId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@unique([ownerPartnerId, phone])
  @@index([phone])
}

model Order {
  id                     String                 @id @default(cuid())
  orderNumber            Int                    @unique
  partnerId              String
  createdById            String
  customerId             String
  status                 OrderStatus            @default(CONFIRMED)
  quantity               Int
  notes                  String?
  currency               String                 @default("TND")
  partnerConfirmedAt     DateTime?
  unitSellingPrice       Decimal                @db.Decimal(12, 3)
  productCost            Decimal                @db.Decimal(12, 3)
  packagingCost          Decimal                @db.Decimal(12, 3)
  deliveryCost           Decimal                @db.Decimal(12, 3)
  contribution           Decimal                @db.Decimal(12, 3)
  commissionType         CommissionType
  commissionValue        Decimal                @db.Decimal(12, 3)
  commissionSource       CommissionSource
  partnerEarning         Decimal                @db.Decimal(12, 3)
  platformShare          Decimal                @db.Decimal(12, 3)
  adjustmentsTotal       Decimal                @default(0) @db.Decimal(12, 3)
  deliveredAt            DateTime?
  settlementDueAt        DateTime?
  earningStatus          EarningStatus          @default(NONE)
  statusBeforeHold       OrderStatus?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  partnerSharePercentage Decimal?               @db.Decimal(5, 2)
  performanceLevelName   String?
  transactions           FinancialTransaction[]
  createdBy              User                   @relation(fields: [createdById], references: [id])
  customer               Customer               @relation(fields: [customerId], references: [id])
  partner                Partner                @relation(fields: [partnerId], references: [id])
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  returnRecord           Return?
  shipment               Shipment?

  @@index([status, createdAt])
  @@index([partnerId, createdAt])
  @@index([customerId])
  @@index([deliveredAt])
  @@index([settlementDueAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 3)
  productName String
  productSlug String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  oldStatus   OrderStatus?
  newStatus   OrderStatus
  changedById String?
  reason      String?
  createdAt   DateTime     @default(now())
  changedBy   User?        @relation(fields: [changedById], references: [id])
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Return {
  id          String     @id @default(cuid())
  orderId     String     @unique
  kind        ReturnKind
  reason      String?
  costCharged Decimal    @default(0) @db.Decimal(12, 3)
  currency    String     @default("TND")
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Wallet {
  id               String   @id @default(cuid())
  partnerId        String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(12, 3)
  pendingBalance   Decimal  @default(0) @db.Decimal(12, 3)
  totalEarned      Decimal  @default(0) @db.Decimal(12, 3)
  totalWithdrawn   Decimal  @default(0) @db.Decimal(12, 3)
  currency         String   @default("TND")
  updatedAt        DateTime @updatedAt
  partner          Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model FinancialTransaction {
  id             String                     @id @default(cuid())
  partnerId      String
  orderId        String?
  withdrawalId   String?                    @unique
  type           FinancialTransactionType
  amount         Decimal                    @db.Decimal(12, 3)
  currency       String                     @default("TND")
  status         FinancialTransactionStatus @default(AVAILABLE)
  availableAt    DateTime?
  description    String?
  idempotencyKey String                     @unique
  createdById    String?
  createdAt      DateTime                   @default(now())
  createdBy      User?                      @relation(fields: [createdById], references: [id])
  order          Order?                     @relation(fields: [orderId], references: [id])
  partner        Partner                    @relation(fields: [partnerId], references: [id])
  withdrawal     Withdrawal?                @relation(fields: [withdrawalId], references: [id])

  @@index([partnerId, status])
  @@index([status, availableAt])
  @@index([orderId])
}

model Withdrawal {
  id                   String                @id @default(cuid())
  partnerId            String
  amount               Decimal               @db.Decimal(12, 3)
  currency             String                @default("TND")
  paymentMethod        String
  paymentAccount       String
  status               WithdrawalStatus      @default(REQUESTED)
  requestedAt          DateTime              @default(now())
  reviewedAt           DateTime?
  paidAt               DateTime?
  transactionReference String?
  reviewedById         String?
  rejectionReason      String?
  transactions         FinancialTransaction?
  partner              Partner               @relation(fields: [partnerId], references: [id])
  reviewedBy           User?                 @relation("WithdrawalReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([partnerId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model TelegramAuthorizedUser {
  id             String     @id @default(cuid())
  /// Stable Telegram identity (numeric id). Never the @username.
  telegramUserId String     @unique
  displayName    String?
  status         UserStatus @default(ACTIVE)
  authorizedAt   DateTime   @default(now())
  revokedAt      DateTime?
  /// Who inside E-COM COLAB granted this access.
  authorizedById String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
}

model TelegramSession {
  id             String   @id @default(cuid())
  telegramUserId String
  /// Current wizard step, or IDLE once the conversation is finished.
  step           String   @default("IDLE")
  /// Partially collected product data; validated on completion.
  data           Json?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// Hard expiry: an abandoned conversation must never resurrect.
  expiresAt      DateTime
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])

  @@index([telegramUserId, status])
  @@index([expiresAt])
}

/// Processed-update ledger. The unique update_id is what makes the webhook
/// idempotent: Telegram retries deliveries, and a retry must not create a
/// second product.
model TelegramUpdate {
  id             String   @id @default(cuid())
  /// Telegram's per-update identifier.
  updateId       String   @unique
  telegramUserId String?
  kind           String
  processedAt    DateTime @default(now())

  @@index([telegramUserId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PARTNER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PartnerStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
  CLOSED
}

/// Self-declared e-commerce experience (registration). Stored as ASCII enum
/// values; the French labels live in `src/modules/registration/schemas.ts`.
enum EcommerceExperience {
  DEBUTANT
  INTERMEDIAIRE
  EXPERT
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
  DRAFT
}

/// * Where a product record originated. ADMIN = created in the dashboard.
enum ProductSource {
  ADMIN
  TELEGRAM
}

enum MediaType {
  IMAGE
  VIDEO
  THUMBNAIL
}

enum MarketingAssetKind {
  AD_COPY
  HOOK
  CAPTION
  DESCRIPTION
  SCRIPT
  FAQ
  CREATIVE
  OFFER
  SELLING_POINT
  OBJECTION_ANSWER
}

enum PartnerProductStatus {
  ACTIVE
  INACTIVE
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionSource {
  GLOBAL
  PRODUCT
  PARTNER
  PARTNER_PRODUCT
}

enum OrderStatus {
  CONFIRMED
  VALIDATED
  ON_HOLD
  PREPARING
  PACKAGED
  SHIPPED
  IN_DELIVERY
  DELIVERED
  REFUSED
  RETURNED
  CANCELLED
}

enum EarningStatus {
  NONE
  PENDING
  AVAILABLE
  REVERSED
}

enum FinancialTransactionType {
  PARTNER_EARNING
  RETURN_COST
  WITHDRAWAL
  ADJUSTMENT
}

enum FinancialTransactionStatus {
  PENDING
  AVAILABLE
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}

enum ReturnKind {
  REFUSED
  RETURNED
}

enum NotificationType {
  ORDER_STATUS
  EARNING
  SETTLEMENT
  WITHDRAWAL
  STOCK
  SYSTEM
}

model Expense {
  id           String        @id @default(cuid())
  title        String
  category     String
  amount       Decimal       @db.Decimal(12, 3)
  currency     String        @default("TND")
  status       ExpenseStatus @default(PENDING)
  period       String?
  notes        String?
  approvedAt   DateTime?
  approvedById String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, period])
  @@index([createdAt])
}

model ReferralLink {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  code      String   @unique
  clicks    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model ReferralAttribution {
  id                 String                    @id @default(cuid())
  referrerPartnerId  String
  referrerPartner    Partner                   @relation("ReferrerAttributions", fields: [referrerPartnerId], references: [id])
  referredPartnerId  String                    @unique
  referredPartner    Partner                   @relation("ReferredAttribution", fields: [referredPartnerId], references: [id])
  type               ReferralType              @default(PARTNER)
  status             ReferralAttributionStatus @default(PENDING_QUALIFICATION)
  qualifyingOrderId  String?
  qualifiedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  commissions        ReferralCommission[]

  @@index([referrerPartnerId, status])
}

model ReferralCommission {
  id                 String                   @id @default(cuid())
  attributionId      String
  attribution        ReferralAttribution      @relation(fields: [attributionId], references: [id])
  referrerPartnerId  String
  referrerPartner    Partner                  @relation(fields: [referrerPartnerId], references: [id])
  orderId            String?
  amount             Decimal                  @db.Decimal(12, 3)
  currency           String                   @default("TND")
  status             ReferralCommissionStatus @default(PENDING_VERIFICATION)
  idempotencyKey     String                   @unique
  calculationDetails Json?
  approvedAt         DateTime?
  approvedById       String?
  paidAt             DateTime?
  paidById           String?
  rejectionReason    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([referrerPartnerId, status])
  @@index([attributionId])
  @@index([orderId])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReferralType {
  PARTNER
  SALES
}

enum ReferralAttributionStatus {
  PENDING_QUALIFICATION
  QUALIFIED
  REJECTED
}

enum ReferralCommissionStatus {
  PENDING_VERIFICATION
  ELIGIBLE
  APPROVED_FOR_PAYMENT
  PAID
  REVERSED
  REJECTED
}

